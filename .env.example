# LAMLA Guide AI - Environment Configuration
# "It's Never Too Late To Study."

# PORT CONFIGURATION (User specified local port: 3001)
PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# SUPABASE CREDENTIALS (Required for Auth, PostgreSQL Database, and Storage)
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# AI PROVIDER CREDENTIALS (Configurable: Google Gemini or OpenAI)
# Primary Recommendation: Google Gemini API (Free tier available)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
# Alternative: OPENAI_API_KEY=your-openai-api-key-here

# WHATSAPP MANUAL PAYMENT & SUPPORT CONFIGURATION
# Admin WhatsApp phone number in international format without '+' or spaces (e.g., 233240000000 for Ghana)
NEXT_PUBLIC_ADMIN_WHATSAPP_NUMBER=233000000000
NEXT_PUBLIC_ADMIN_SUPPORT_EMAIL=bismarkanadjei@gmail.com

# PLATFORM DEFAULT SETTINGS
NEXT_PUBLIC_CURRENCY=GHS
NEXT_PUBLIC_PLATFORM_NAME=LAMLA Guide AI
NEXT_PUBLIC_SLOGAN="It's Never Too Late To Study."
